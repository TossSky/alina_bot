# ==================== Telegram Bot Configuration ====================
# Your bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ==================== OpenAI API Configuration ====================
# Your OpenAI API key from platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Model to use for chat completions (e.g., gpt-5-chat-latest, gpt-4-turbo, gpt-3.5-turbo)
OPENAI_MODEL=gpt-5-chat-latest

# Optional: Custom OpenAI API base URL (leave empty for default)
# Useful for proxy or alternative OpenAI-compatible APIs
OPENAI_BASE_URL=

# ==================== Proxy Settings (Optional) ====================
# Enable proxy for OpenAI API requests
# Set to true if you need to use a proxy, false otherwise
USE_PROXY=false

# Proxy URL (required if USE_PROXY=true)
# Format: http://host:port or socks5://host:port
PROXY_URL=

# ==================== Database Configuration ====================
# Path to SQLite database file
# Will be created automatically if doesn't exist
DB_PATH=alina.db

# ==================== Debug Mode ====================
# Enable debug logging (more verbose output)
# Set to true for development, false for production
DEBUG=false

# ==================== Admin Configuration ====================
# Comma-separated list of admin Telegram user IDs
# Admins can use special commands like /restart and /reset_limits
# To get your user ID, send a message to @userinfobot
ADMIN_IDS=367288553,7372093786,916411940

# ==================== YooKassa Payment Configuration ====================
# YooKassa shop ID from your merchant dashboard
YOOKASSA_SHOP_ID=your_shop_id_here

# YooKassa secret key from your merchant dashboard
YOOKASSA_SECRET_KEY=your_secret_key_here

# Note: Payment status is automatically checked every 5 seconds

# ==================== Subscription Settings ====================
# Require subscription after free tier limits
# Set to false to disable subscription requirement (unlimited free usage)
SUBSCRIPTION_REQUIRED=true

# Free tier limits for users without subscription
# Number of messages before requiring subscription
FREE_MESSAGES_LIMIT=15

# Total tokens before requiring subscription
# Approximate: 1 token ≈ 0.75 words
FREE_TOKENS_LIMIT=2000

# Number of images (vision requests) before requiring subscription
FREE_IMAGES_LIMIT=5

# ==================== Image Processing Settings ====================
# Maximum image file size in megabytes
# Larger images will be rejected
MAX_IMAGE_SIZE_MB=10

# Image detail level for vision API:
# - low: Faster, cheaper, less detail (512x512 resolution)
# - high: Slower, more expensive, more detail (high resolution)
# - auto: Let OpenAI decide based on image
IMAGE_DETAIL_LEVEL=auto
