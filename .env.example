# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # Рекомендуется для баланса скорости и качества

# Custom API Endpoint (Optional)
# Для OpenRouter, Together AI, Ollama и др.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Proxy Settings (Optional)
USE_PROXY=false
PROXY_URL=

# Database
DB_PATH=alina.db

# Debug Mode
DEBUG=false

# Admin Settings
# Список Telegram ID администраторов (через запятую)
# Пример: ADMIN_IDS=123456789,987654321
# Если не указано, команда /restart доступна всем
ADMIN_IDS=
